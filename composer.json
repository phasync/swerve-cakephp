{
    "name": "phasync/swerve-cakephp",
    "description": "Run CakePHP applications on swerve: booted once per worker, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["cakephp", "swerve", "phasync", "application server", "long-running", "psr-15", "websocket"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "cakephp/cakephp": "^5.1",
        "phasync/phasync": "^2.0",
        "phasync/swerve": "^0.1",
        "phasync/swerve-psr15": "^0.1",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "Swerve\\CakePHP\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "swerve": {
            "adapter": "cakephp",
            "entry": "Swerve\\CakePHP\\entry"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "name": "swerve-psr15",
            "type": "vcs",
            "url": "https://github.com/phasync/swerve-psr15"
        }
    ]
}
